{
  "name": "Urban DENUE EDA",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteEnv": {
    "URBAN_DENUE_HOME": "${containerWorkspaceFolder}/var/denue"
  }
}
